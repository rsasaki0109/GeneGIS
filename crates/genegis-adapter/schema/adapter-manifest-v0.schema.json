{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genegis.org/schemas/adapter-manifest/0.1.0/schema.json",
  "title": "GeneGIS Adapter Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "adapter_version", "backend", "license", "operations"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "adapter_id": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "backend": { "$ref": "#/$defs/backend" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "engine_version", "build_digest", "components"],
      "properties": {
        "family": { "enum": ["gdal", "duck_db_spatial", "postgis", "grass", "qgis_processing"] },
        "engine_version": { "type": "string", "minLength": 1 },
        "build_digest": { "$ref": "#/$defs/digest" },
        "components": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "operation_version", "inputs", "outputs", "capabilities", "determinism", "evidence_hooks", "opaque"],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1 },
        "operation_version": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["file_read", "file_write", "network_read", "network_write", "database_read", "database_write", "process_spawn", "native_code", "gpu"] }
        },
        "determinism": { "enum": ["deterministic", "seeded", "tolerance_bounded", "unknown"] },
        "evidence_hooks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["input_digests", "output_digests", "parameters", "query_plan_digest", "warnings", "component_identity", "environment_digest", "io_metrics", "transaction_context"] }
        },
        "opaque": { "type": "boolean" }
      }
    }
  }
}

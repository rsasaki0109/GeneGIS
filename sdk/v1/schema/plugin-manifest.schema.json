{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.genegis.org/sdk/v1/plugin-manifest.schema.json",
  "title": "GeneGIS SDK v1 Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "api_version", "capabilities", "artifact_digest"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "api_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string"},
    "author": {"type": "string"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["read_catalog", "read_storage", "analysis_step", "render_hook", "export_artifact", "publish_stac"]}
    },
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9A-Fa-f]{64}$"},
    "wasm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {"entry": {"type": "string", "pattern": "^[^/\\\\].*\\.wasm$"}}
    }
  }
}
